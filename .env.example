MAIL_PROVIDER=resend
MAIL_DOMAIN=mail.wtfgameshow.app
MAIL_FROM_DOMAIN=mail.wtfgameshow.app
MAIL_INBOUND_ENABLED=0
MAIL_OUTBOUND_ENABLED=0
