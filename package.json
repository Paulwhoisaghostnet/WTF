{
  "name": "wtf-gameshow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --log-level=warning --external:pg-native --external:bufferutil --external:utf-8-validate --external:passport-github2 --external:passport-twitter --external:passport-discord --external:esbuild --external:lightningcss && esbuild scripts/run-supabase-backup.ts --bundle --platform=node --format=cjs --outfile=dist/run-supabase-backup.cjs --log-level=warning --external:pg-native --external:bufferutil --external:utf-8-validate --external:esbuild --external:lightningcss && esbuild scripts/backfill-contract-metadata.ts --bundle --platform=node --format=cjs --outfile=dist/backfill-contract-metadata.cjs --log-level=warning --external:pg-native --external:bufferutil --external:utf-8-validate --external:esbuild --external:lightningcss && esbuild scripts/import-intel-csv.ts --bundle --platform=node --format=cjs --outfile=dist/import-intel-csv.cjs --log-level=warning --external:pg-native --external:bufferutil --external:utf-8-validate --external:esbuild --external:lightningcss",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "backup:db": "docker compose exec app bash /app/scripts/backup-db.sh",
    "start": "NODE_ENV=production node dist/index.cjs",
    "db:push": "node scripts/db-push.mjs",
    "db:push:supabase": "node scripts/db-push.mjs --supabase",
    "db:push:raw": "drizzle-kit push",
    "db:setup:local": "node scripts/setup-local-db.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:check": "node scripts/check-db-connection.mjs",
    "db:print-url": "node scripts/resolve-database-url.mjs",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "contract:test": "bash scripts/test-marketplace-contract.sh",
    "contract:test:in-app-market": "bash scripts/test-in-app-market-contract.sh",
    "contract:test:casino-membership": "bash scripts/test-casino-membership-contract.sh",
    "contract:test:club-dues": "bash scripts/test-club-dues-contract.sh",
    "contract:test:wtf-xtz": "bash scripts/test-wtf-xtz-exchange.sh",
    "contract:deploy:in-app-market:kiln": "tsx scripts/wtf-in-app-market/deploy-shadownet-kiln.ts",
    "contract:e2e:in-app-market:shadownet": "tsx scripts/wtf-in-app-market/e2e-shadownet-kiln.ts",
    "contract:prepare:in-app-market:mainnet": "tsx scripts/wtf-in-app-market/prepare-mainnet-artifact.ts",
    "contract:deploy:wtf-xtz:kiln": "tsx scripts/wtf-xtz-exchange/deploy-shadownet-kiln.ts",
    "contract:e2e:wtf-xtz:shadownet": "tsx scripts/wtf-xtz-exchange/e2e-shadownet.ts",
    "contract:prepare:wtf-xtz:mainnet": "tsx scripts/wtf-xtz-exchange/prepare-mainnet-artifact.ts",
    "install-games": "node scripts/install-games.mjs",
    "install-games:force": "node scripts/install-games.mjs --force",
    "casino:wtf-button:simulation": "tsx scripts/run-wtf-button-simulation.ts",
    "casino:tables:simulation": "tsx scripts/run-casino-table-simulations.ts",
    "casino:raceway:assets": "tsx scripts/generate-guinea-pig-raceway-assets.ts",
    "creation-tools:check": "tsx scripts/check-creation-tool-assets.ts",
    "check": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:inventory": "npm run build && playwright test tests/playwright/inventory",
    "test:e2e:inventory:coverage": "tsx tests/e2e/inventory/coverage.ts",
    "test:e2e:puppets:prepare-db": "tsx tests/e2e/puppets/prepare-local-db.ts",
    "test:e2e:puppets:seed": "tsx tests/e2e/puppets/seed.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.mjs",
    "test:e2e:live:puppets": "npm run test:e2e:puppets:seed && WTF_E2E_START_SERVER=1 WTF_E2E_REUSE_SERVER=0 PORT=${PORT:-3307} playwright test --config=playwright.live.config.mjs tests/playwright/live",
    "test:e2e:full": "npm run test:e2e:inventory:coverage && npm run test:e2e",
    "collekt:dev": "npm --prefix apps/collekt run dev",
    "collekt:build": "npm --prefix apps/collekt run build",
    "collekt:check": "npm --prefix apps/collekt run test",
    "operator-signer:build": "npm --prefix extensions/wtf-operator-signer run build",
    "operator-signer:check": "npm --prefix extensions/wtf-operator-signer run typecheck",
    "operator-signer:test": "tsx --test server/features/operator-signer/client.test.ts",
    "platform-wallets": "tsx scripts/platform-wallets.ts",
    "wtf-domain-bot:check": "npm --prefix extensions/wtf-domain-bot run typecheck",
    "wtf-gameshow-bot:build": "npm --prefix extensions/wtf-gameshow-bot run build",
    "wtf-gameshow-bot:check": "npm --prefix extensions/wtf-gameshow-bot run typecheck",
    "wtf-subdomains:test": "tsx --test server/features/wtf-subdomains/chat.test.ts",
    "ux-lab:panel": "tsx scripts/run-ux-lab-panel.ts",
    "check:external-links": "node scripts/check-external-links.mjs",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.96.2",
    "@taquito/beacon-wallet": "^24.3.0",
    "@taquito/taquito": "^24.3.0",
    "@taquito/tzip12": "^24.3.0",
    "@taquito/tzip16": "^24.3.0",
    "@taquito/utils": "^24.3.0",
    "@tezos-x/octez.connect-sdk": "^4.8.3",
    "@types/matter-js": "^0.20.2",
    "blakejs": "^1.2.1",
    "bs58check": "^4.0.0",
    "buffer": "^6.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "lucide-react": "^1.7.0",
    "matter-js": "^0.20.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "passport-github2": "^0.1.12",
    "passport-local": "^1.0.0",
    "passport-strategy": "^1.0.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react95": "^4.0.0",
    "styled-components": "^6.3.12",
    "three": "^0.184.0",
    "viem": "^2.48.8",
    "wouter": "^3.9.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "overrides": {
    "esbuild": "0.28.0",
    "@taquito/http-utils": "24.3.0",
    "@taquito/local-forging": "24.3.0",
    "@taquito/michel-codec": "24.3.0",
    "@taquito/michelson-encoder": "24.3.0",
    "@taquito/rpc": "24.3.0",
    "@taquito/signer": "24.3.0",
    "@taquito/core": "24.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
