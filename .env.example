# Override this if Kiln moves into the compose network or onto another host.
KILN_API_URL=
KILN_PUBLIC_URL=https://kiln.wtfgameshow.app
KILN_TIMEOUT_MS=120000
# Must match the host-native Kiln service API_AUTH_TOKEN. Production deploy
# probes a protected public mutation route without this token and fails if the
