RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# WTFOS AT PROTOCOL PDS — sovereign WTFOS repo spine
#
# The WTFOS app can link a user's canonical AT Protocol DID to a WTFOS-hosted
# DID/repo. Enable the Docker Compose profile with:
#   docker compose --profile wtfos-pds up -d wtfos-pds
# Then set these app-facing URLs so `/api/tz2at/pds/status` can prove health.
# -----------------------------------------------------------------------------
WTFOS_PDS_PUBLIC_URL=https://pds.wtfgameshow.app
WTFOS_PDS_INTERNAL_URL=http://wtfos-pds:3000
WTFOS_PDS_HEALTH_URL=http://wtfos-pds:3000/xrpc/_health
WTFOS_PDS_PROVISIONING_ENABLED=false
WTFOS_ATPROTO_HANDLE_DOMAIN=wtfgameshow.app
WTFOS_PDS_HOSTNAME=pds.wtfgameshow.app
WTFOS_PDS_DATA_DIR=/mnt/wtf-data/pds
WTFOS_PDS_JWT_SECRET=
WTFOS_PDS_ADMIN_PASSWORD=
WTFOS_PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
WTFOS_PDS_INVITE_REQUIRED=true
WTFOS_PDS_INVITE_CODE=
WTFOS_PDS_ACCOUNT_EMAIL_DOMAIN=wtfgameshow.app
WTFOS_PDS_RATE_LIMITS_ENABLED=true
WTFOS_PDS_CRAWLERS=https://bsky.network

# Primary WTFOS repo used for platform-wide `app.wtfos.*` event publication.
# User-specific events are also published to the user's linked WTF DID repo
# when `wtfos_atproto_identities.status=active`.
WTFOS_PRIMARY_ATPROTO_DID=
WTFOS_PRIMARY_ATPROTO_HANDLE=wtfgameshow.app
WTFOS_PRIMARY_PDS_URL=http://wtfos-pds:3000
WTFOS_PRIMARY_PDS_IDENTIFIER=wtfgameshow.app
WTFOS_PRIMARY_PDS_PASSWORD=
WTFOS_PRIMARY_PDS_ACCESS_JWT=
WTFOS_PRIMARY_PDS_REFRESH_JWT=

# -----------------------------------------------------------------------------
# MEDIA / DEPLOY — optional paths & build metadata
# -----------------------------------------------------------------------------
# Legacy fallback only. Production uploads should use UPLOAD_STAGING_DIR +
