{
  "lexicon": 1,
  "id": "app.wtfos.identity.siteSnapshot",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Renderable immutable snapshot for a wtfOS-hosted user site version. Kept in the user's WTFOS repo so the .me serving tier does not need the app database.",
      "record": {
        "type": "object",
        "required": [
          "$type",
          "schemaVersion",
          "host",
          "url",
          "versionDigest",
          "versionNumber",
          "payload",
          "didTarget",
          "publishedAt"
        ],
        "properties": {
          "$type": { "type": "string", "const": "app.wtfos.identity.siteSnapshot" },
          "schemaVersion": { "type": "integer" },
          "host": { "type": "string" },
          "url": { "type": "string" },
          "versionDigest": { "type": "string" },
          "versionNumber": { "type": "integer" },
          "payload": { "type": "ref", "ref": "#payload" },
          "didTarget": {
            "type": "object",
            "required": ["did", "source"],
            "properties": {
              "did": { "type": "string" },
              "source": { "type": "string", "knownValues": ["wtf", "bsky"] },
              "handle": { "type": "string" }
            }
          },
          "publishedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["pages", "assetMediaIds"],
      "properties": {
        "pages": {
          "type": "array",
          "items": { "type": "ref", "ref": "#page" },
          "maxLength": 26
        },
        "assetMediaIds": {
          "type": "array",
          "items": { "type": "integer" },
          "maxLength": 200
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["slug", "title", "html"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "html": { "type": "string" }
      }
    }
  }
}
