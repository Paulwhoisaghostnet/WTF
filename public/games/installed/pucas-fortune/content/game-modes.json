        { "name": "Fifteen",   "baseChips": 13, "baseMult": 1, "chipsPerLevel": 8,  "multPerLevel": 0.4 },
        { "name": "Run",       "baseChips": 17, "baseMult": 1, "chipsPerLevel": 9,  "multPerLevel": 0.5 },
        { "name": "Flush",     "baseChips": 21, "baseMult": 1, "chipsPerLevel": 15, "multPerLevel": 0.75 }
