# -----------------------------------------------------------------------------
# NODE — process
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# WTF TV — cache, IPFS proxy, media fetch
#
# Looping channels replay the same videos over and over, so the media
# cache is sized generously and lives on a persistent Docker volume
# (/app/cache).  IPFS content is immutable and is never re-fetched on a
# schedule; it is only evicted when the total size budget is hit and it
# falls out of the LRU window.
# -----------------------------------------------------------------------------
TV_CACHE_DIR=/app/cache/tv
TV_CACHE_MAX_AGE_DAYS=30
# Per-file cap (bytes).  Default 500 MB.
TV_CACHE_MAX_REMOTE_BYTES=
# Total cache budget (bytes).  Default 10 GB.
TV_CACHE_MAX_TOTAL_BYTES=
TV_CACHE_ALLOWED_HOSTS=
TV_MEDIA_FETCH_TIMEOUT_MS=15000
TV_IPFS_GATEWAYS=

# Server-side cache warmer.  Walks every active channel's playlist and
# downloads each artifact to /app/cache/tv on a fixed cadence, so the
# first viewer never eats an IPFS cold-fetch.  Runs once shortly after
# boot and then on an interval.  Idempotent — a pass over an already-
# hot cache is stat-only and cheap.
TV_CACHE_WARM_CONCURRENCY=3
TV_CACHE_WARM_INTERVAL_MS=120000
TV_CACHE_WARM_BOOT_DELAY_MS=15000

# -----------------------------------------------------------------------------
# W FEED / X API — timeline + link preview tuning
# -----------------------------------------------------------------------------
X_API_BASE_URL=
W_FEED_CACHE_MS=60000
W_FEED_MAX_ACCOUNTS=100
W_POSTS_PER_ACCOUNT=10
W_TIMELINE_DAYS_BACK=7
# W timeline: DB-first from IDs + filtered stream near-real-time ingest + optional search polling backfill + free oEmbed text.
USE_LEGACY_TIMELINE_FANOUT=0
# Filtered stream (/2/tweets/search/stream): set 0 to rely on search polling only.
W_TIMELINE_STREAM_ENABLED=1
W_TIMELINE_STREAM_RECONNECT_MAX_MS=64000
W_TIMELINE_STREAM_MAX_RULES=25
W_TIMELINE_STREAM_HANDLES_PER_RULE=20
# Optional newline/comma/space separated handles file, mounted read-only in Docker.
# Lines may include @handles and # comments; app merges this with verified WTF user handles.
W_TIMELINE_STREAM_HANDLES_FILE=/app/config/w-stream-handles.txt
W_TIMELINE_STREAM_RULE_REFRESH_MS=60000
WTF_CONFIG_DIR_HOST=/mnt/wtf-data/config
# Legacy managed stream handles are still preserved in W → Settings admin UI.
# Background search ingest (safety-net backfill via /tweets/search/recent), default every 15 min.
W_TIMELINE_WORKER_INTERVAL_MS=900000
W_TIMELINE_SEARCH_CHUNK_CHARS=420
W_TIMELINE_SEARCH_MAX_PAGES=3
W_TIMELINE_DB_TTL_DAYS=14
W_X_USER_ID_CACHE_MS=21600000
W_LINK_PREVIEW_CACHE_MS=21600000
W_LINK_PREVIEW_TIMEOUT_MS=3500
W_LINK_PREVIEW_MAX_BYTES=358400
W_LINK_PREVIEW_MAX=30
# Default WTF Gameshow X account used for W groupchat mirroring and admin DMs.
# Prefer storing an encrypted token generated with TWITTER_TOKEN_ENCRYPTION_KEY.
W_X_DEFAULT_ACCOUNT_HANDLE=wtf_gameshow
W_X_DEFAULT_ACCOUNT_USER_ID=
W_X_DEFAULT_ACCOUNT_ACCESS_TOKEN=
W_X_DEFAULT_ACCOUNT_OAUTH2_ACCESS_TOKEN=
W_X_GAMESHOW_DM_CONVERSATION_ID=
# X Activity API bridge: app bearer opens /2/activity/stream; subscriptions
# wake the groupchat cache hydrator. Keep the scheduler as hourly safety sweep.
W_XAA_GROUPCHAT_ENABLED=1
W_XAA_GROUPCHAT_USER_IDS=
W_XAA_GROUPCHAT_EVENT_TYPES=chat.received,chat.sent
W_XAA_RECONNECT_MAX_MS=64000
W_XAA_HYDRATE_MIN_GAP_MS=5000
W_X_GROUPCHAT_SYNC_INTERVAL_MS=3600000
# W/X monthly budget guards. Unit prices are estimates used to stop WTF before
# background features run past the operator's configured spend limits.
W_X_BUDGET_TIMELINE_STREAM_UNIT_USD=0.005
W_X_BUDGET_TIMELINE_STREAM_SOFT_USD=35
W_X_BUDGET_TIMELINE_STREAM_HARD_USD=45
W_X_BUDGET_SEARCH_RECOVERY_UNIT_USD=0.005
W_X_BUDGET_SEARCH_RECOVERY_HARD_USD=3
W_X_BUDGET_GROUPCHAT_READ_UNIT_USD=0.010
W_X_BUDGET_GROUPCHAT_READ_HARD_USD=5
W_X_BUDGET_GROUPCHAT_WRITE_UNIT_USD=0.015
W_X_BUDGET_GROUPCHAT_WRITE_HARD_USD=5

