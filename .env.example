# =============================================================================
# WTF Gameshow — copy to `.env` and fill in. Do not commit `.env`.
# =============================================================================
#
# PUBLIC / NON-SECRET KEYS live in `.env.public` (committed).
# Load order: `.env.public` then `.env` (server, Vite, drizzle-kit).
# Keep secrets (DATABASE_URL, SESSION_SECRET, *_SECRET, bearer tokens)
# only in `.env` or host environment. Do not duplicate secrets into `.env.public`.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# POSTGRES — local Docker instance or external host
# -----------------------------------------------------------------------------
# When running with docker-compose, DATABASE_URL is injected automatically.
# For local dev without Docker, point at your local Postgres:
DATABASE_URL=postgresql://wtf:changeme@localhost:5432/wtf

# Password used by docker-compose.yml for the Postgres container
POSTGRES_PASSWORD=changeme

# Optional: max connections in node-pg pool (default 15)
# DATABASE_POOL_MAX=15

# -----------------------------------------------------------------------------
# SUPABASE — backup target only (optional)
# -----------------------------------------------------------------------------
# The app no longer uses Supabase JS or the Supabase REST API.
# These are retained only if you want pg_dump → Supabase restore backups.
# SUPABASE_BACKUP_URL=postgresql://postgres.[ref]:PASSWORD@aws-0-[region].pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
SESSION_SECRET=
# Production: exact site URL with https, no trailing slash (e.g. https://wtfgameshow.com)
# Local dev: http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: server-side GitHub personal access token for API calls (raises rate limit)
GITHUB_TOKEN=

# Twitter OAuth 1.0a (passport-twitter)
# Callback URL in Twitter app must be: ${PUBLIC_SITE_URL}/api/auth/twitter/callback
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
# Optional: dedicated secret for encrypting stored OAuth tokens (falls back to SESSION_SECRET)
TWITTER_TOKEN_ENCRYPTION_KEY=

# X API v2 bearer token for W timeline ingestion
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
# Optional X API override (defaults to https://api.x.com/2)
X_API_BASE_URL=

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Caddy: domain for TLS (used in Caddyfile via $SITE_DOMAIN)
SITE_DOMAIN=wtfgameshow.com
