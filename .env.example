# -----------------------------------------------------------------------------
# MACARONI — blind-mint drop studio, server-side IPFS pinning
# -----------------------------------------------------------------------------
WTFGAMESHOW_IPFS_JWT=
# Per-file cap (bytes) for trusted creator Macaroni IPFS pin uploads. Default 1 GB (1073741824).
# Studio also requires the selected artwork set to average 250 MB or less.
MACARONI_IPFS_MAX_BYTES=
# Optional direct-origin upload lane for large Macaroni hosted pinning. Point this
# at a DNS-only/non-Cloudflare hostname such as https://upload.wtfos.app so the
# actual multipart file POST can bypass Cloudflare's request body cap. Studio
# first gets a short-lived same-origin upload ticket, then POSTs only
# /api/macaroni/ipfs/upload to this origin with a bearer ticket.
# Production also serves https://upload.5-78-202-50.sslip.io as an origin-only
# fallback until upload.wtfos.app is set to DNS-only in Cloudflare.
MACARONI_DIRECT_UPLOAD_ORIGIN=
# Optional dedicated HMAC secret for Macaroni upload tickets. Defaults to
# SESSION_SECRET when blank; set a separate high-entropy value in production if
# direct uploads are enabled.
MACARONI_UPLOAD_TICKET_SECRET=

# -----------------------------------------------------------------------------
# NODE — process
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# WTF TV — cache, IPFS proxy, media fetch
#
# Looping channels replay the same videos over and over, so the media
# cache is sized generously and lives on a persistent Docker volume
# (/app/cache).  IPFS content is immutable and is never re-fetched on a
# schedule; it is only evicted when the total size budget is hit and it
# falls out of the LRU window.
# -----------------------------------------------------------------------------
TV_CACHE_DIR=/app/cache/tv
TV_CACHE_MAX_AGE_DAYS=30
# Per-file cap (bytes).  Default 500 MB.
TV_CACHE_MAX_REMOTE_BYTES=
# Total cache budget (bytes).  Default 10 GB.
TV_CACHE_MAX_TOTAL_BYTES=
TV_CACHE_ALLOWED_HOSTS=
TV_MEDIA_FETCH_TIMEOUT_MS=15000
TV_IPFS_GATEWAYS=

# Server-side cache warmer.  Walks every active channel's playlist and
# downloads each artifact to /app/cache/tv on a fixed cadence, so the
# first viewer never eats an IPFS cold-fetch.  Runs once shortly after
# boot and then on an interval.  Idempotent — a pass over an already-
# hot cache is stat-only and cheap.
TV_CACHE_WARM_CONCURRENCY=3
TV_CACHE_WARM_INTERVAL_MS=120000
TV_CACHE_WARM_BOOT_DELAY_MS=15000

# -----------------------------------------------------------------------------
# W FEED / X API — timeline + link preview tuning
# -----------------------------------------------------------------------------
X_API_BASE_URL=
# Emergency global kill switch for background X API spend.  Keep this on in
# production until each X worker has an explicit monthly budget and owner.
X_API_BACKGROUND_SPEND_DISABLED=1
W_FEED_CACHE_MS=60000
W_FEED_MAX_ACCOUNTS=100
W_POSTS_PER_ACCOUNT=10
W_TIMELINE_DAYS_BACK=7
# W Tezos digest (default: read-only profile URL scrape — no X API, no DMs, no native actions).
# Modes: digest | stream | search | off  (scraper is an alias for digest)
W_TIMELINE_INGEST_MODE=digest
W_TIMELINE_SCRAPER_ENABLED=1
W_DIGEST_SCRAPER_INTERVAL_MS=600000
W_DIGEST_INITIAL_POSTS_PER_HANDLE=25
W_DIGEST_INCREMENTAL_POSTS_PER_HANDLE=20
# Existing users.id for primary wtfOS outbox rows (prod may not have id=1).
W_DIGEST_ATPROTO_USER_ID=1
W_TIMELINE_SCRAPER_HEADLESS=1
# Scraper session: storage state and/or bot login (never commit real passwords).
# npx tsx scripts/w-x-timeline-scraper.mjs --save-session
W_X_SCRAPER_STORAGE_STATE=
W_X_SCRAPER_USERNAME=
W_X_SCRAPER_PASSWORD=
USE_LEGACY_TIMELINE_FANOUT=0
# Paid Filtered Stream (/2/tweets/search/stream): keep off unless you explicitly want API billing.
W_TIMELINE_STREAM_ENABLED=0
W_TIMELINE_STREAM_RECONNECT_MAX_MS=64000
W_TIMELINE_STREAM_MAX_HANDLES=1000
# Paid search recovery (/tweets/search/recent): recovery-only; set W_TIMELINE_INGEST_MODE=search to use.
W_TIMELINE_SEARCH_RECOVERY_ENABLED=0
W_TIMELINE_SEARCH_WORKER_ENABLED=0
W_TIMELINE_WORKER_INTERVAL_MS=900000
W_TIMELINE_SEARCH_CHUNK_CHARS=420
W_TIMELINE_SEARCH_MAX_PAGES=3
W_TIMELINE_DB_TTL_DAYS=14
W_X_USER_ID_CACHE_MS=21600000
W_LINK_PREVIEW_CACHE_MS=21600000
W_LINK_PREVIEW_TIMEOUT_MS=3500
W_LINK_PREVIEW_MAX_BYTES=358400
W_LINK_PREVIEW_MAX=30
# Designated WTF Gameshow groupchat sync only.  User inbox sync remains off.
W_GROUPCHAT_DM_SYNC_ENABLED=0
W_GROUPCHAT_DM_SYNC_INTERVAL_MS=900000
W_USER_DMS_ENABLED=0
W_USER_DM_SYNC_ENABLED=0
W_DM_BACKFILL_ENABLED=0
# Default WTF Gameshow X account used for W groupchat mirroring and admin DMs.
# Production requires TWITTER_TOKEN_ENCRYPTION_KEY for encrypted OAuth tokens.
# Production deploy also requires TOKEN_ENCRYPTION_KEY (64-char hex) for generic
# server-side token encryption (separate from SESSION_SECRET).
TOKEN_ENCRYPTION_KEY=
TWITTER_TOKEN_ENCRYPTION_KEY=
# Use postgres for shared API rate-limit buckets across app replicas (docker-compose defaults to postgres).
RATE_LIMIT_STORE=postgres
# Drop 'unsafe-inline' from production script-src when the Vite shell is module-only.
CSP_STRICT_SCRIPTS=
W_X_DEFAULT_ACCOUNT_HANDLE=wtf_gameshow
W_X_DEFAULT_ACCOUNT_ACCESS_TOKEN=
W_X_DEFAULT_ACCOUNT_OAUTH2_ACCESS_TOKEN=
W_X_GAMESHOW_DM_CONVERSATION_ID=

# -----------------------------------------------------------------------------
# I HATE TELEGRAM — read-only Tezos Telegram digest bridge
#
# Telegram Bot API usage is free.  TELEGRAM_BOT_TOKEN enables a normal bot
# bridge for approved chats.  TELEGRAM_USER_SESSION is optional infrastructure
# for a WTF-controlled Telegram client session when a bot cannot receive a
# source such as FART NOISES directly.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
I_HATE_TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=
WTF_TELEGRAM_DIGEST_USER_ID=

# -----------------------------------------------------------------------------
# MEDIA / DEPLOY — optional paths & build metadata
# -----------------------------------------------------------------------------
# Legacy fallback only. Production uploads should use UPLOAD_STAGING_DIR +
# Object Storage + MEDIA_HOT_CACHE_DIR.
# UPLOADS_DIR=
# COMMIT_REF=

# -----------------------------------------------------------------------------
# APP REGISTRY — wtfOS universal App Registry (server/features/app-registry)
# -----------------------------------------------------------------------------
# Master flag (default OFF). A clean process admin can DISABLE. When off, the
# registry routes 404, the integrity verifier no-ops, and the legacy desktop app
# launcher behaviour is UNCHANGED (non-destructive). When on, every app must be
# registered with a valid, fingerprint-bound key to be installable.
APP_REGISTRY_ENABLED=false
# Optional: explicit build SHA used as the buildHash leg of the integrity
# fingerprint. Falls back to GIT_COMMIT / SOURCE_VERSION / package version.
# WTFOS_BUILD_SHA=

# -----------------------------------------------------------------------------
# SKYWIRE + WTF LIVE — Bluesky/AT Protocol client (server/routes/skywire.ts)
# -----------------------------------------------------------------------------
# Master AT client flag (default ON unless explicitly false).
# ATPROTO_ENABLED=false
#
# Rollout mode for Skywire + WTF LIVE browser/API access:
#   staff_alpha — admin, host, cohost, resident_wizard, test_subject (default)
#   all_users   — any signed-in non-timeout account
#   disabled    — admin repair access only
SKYWIRE_ROLLOUT_MODE=staff_alpha
# Set false to hide WTF LIVE room/stage lanes while keeping read-only Skywire feeds.
# SKYWIRE_WTF_LIVE_ENABLED=false
#
# Optional actor feeds for WTF + Tezos tabs
# SKYWIRE_WTF_ATPROTO_ACTOR=wtfgameshow.bsky.social
# SKYWIRE_TEZOS_ATPROTO_ACTORS=
#
# Skywire Market/Search tabs use app.bsky.feed.searchPosts, which must hit a
# search-capable Bluesky AppView. public.api.bsky.app rejects searchPosts.
# ATPROTO_SEARCH_APPVIEW=https://api.bsky.app

# -----------------------------------------------------------------------------
# AT PROTOCOL SPINE — wtfOS AT Protocol integration (server/features/atproto-spine)
# -----------------------------------------------------------------------------
# Master flag (default OFF). When off, all NEW structured AT Protocol publish/read
# paths no-op and the OS behaves exactly as before (non-destructive). When on,
# kernel events are mirrored to the multi-PDS spine as app.wtfos.* records.
ATPROTO_SPINE_ENABLED=false

# Network identity / namespace
WTFOS_ATPROTO_NETWORK_DOMAIN=wtfos.me
WTFOS_LEXICON_NAMESPACE=app.wtfos

# Master/primary repo (the OS's own AT identity)
WTFOS_PRIMARY_ATPROTO_DID=
WTFOS_PRIMARY_ATPROTO_HANDLE=
WTFOS_PRIMARY_PDS_URL=
WTFOS_PRIMARY_PDS_IDENTIFIER=
WTFOS_PRIMARY_PDS_PASSWORD=

# PDS service endpoints (internal cluster URLs + public URL)
WTFOS_PDS_PUBLIC_URL=
WTFOS_PDS_INTERNAL_URL=
WTFOS_PDS_USERS_INTERNAL_URL=
WTFOS_PDS_PRIVATE_INTERNAL_URL=
WTFOS_PDS_ADMIN_PASSWORD=
WTFOS_USERS_PDS_INVITE_CODE=

# Per-PDS secret separation (S5.2 hardening). Each PDS (master + 7 domain PDSes + users + private)
# can carry its OWN admin password, JWT secret, and PLC rotation key; all fall back to the shared
# values below when unset (dev may use one shared set; production SHOULD use distinct per-PDS
# secrets so a single compromise can't span the fleet). Names follow:
#   WTFOS_PDS_<NAME>_ADMIN_PASSWORD / _JWT_SECRET / _PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX
#   <NAME> in: MASTER SOCIAL COMMERCE MEDIA ARCADE TEZOS OPS OS USERS PRIVATE
# Shared fallbacks (read by BOTH the kernel and docker-compose):
WTFOS_PDS_JWT_SECRET=
WTFOS_PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# Example per-PDS overrides (uncomment + set distinct values in production):
# WTFOS_PDS_MASTER_ADMIN_PASSWORD=
# WTFOS_PDS_MASTER_JWT_SECRET=
# WTFOS_PDS_MASTER_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
# WTFOS_PDS_USERS_ADMIN_PASSWORD=
# WTFOS_PDS_PRIVATE_ADMIN_PASSWORD=

# Private encrypted repo (DMs / private rooms). ENC key must be 32 bytes.
# Do NOT commit a real key; provision via the secret store.
WTFOS_PRIVATE_PDS_ENC_KEY=
WTFOS_PRIVATE_REPO_DID=
WTFOS_PRIVATE_REPO_IDENTIFIER=
WTFOS_PRIVATE_REPO_PASSWORD=

# DID / PLC (self-hosted PLC mirror + primary)
DID_PLC_URL=
WTFOS_PLC_PRIMARY_URL=
WTFOS_PLC_MIRROR_URL=

# Relay / firehose + federation
WTFOS_RELAY_SUBSCRIBE_URL=
WTFOS_CRAWL_RELAYS=
WTFOS_ACCEPT_EXTERNAL=false
WTFOS_FEDERATED_PDS_HOSTS=
WTFOS_EXTERNAL_COLLECTION_ALLOWLIST=

# CRP Nominations AppView — dedicated AT repo for canonical nominations + Bluesky share posts
CRP_NOMINATIONS_REPO_DID=
CRP_NOMINATIONS_REPO_PDS_URL=
CRP_NOMINATIONS_REPO_IDENTIFIER=
CRP_NOMINATIONS_REPO_PASSWORD=
CRP_NOMINATIONS_REPO_HANDLE=
# Aliases: WTFOS_CRP_NOMINATIONS_REPO_*

# Labeler (self-hosted Ozone-style labels)
WTFOS_LABELER_DID=

# Media gateway (relay-proxy that resolves an echo -> S3 and streams bytes)
WTFOS_MEDIA_GATEWAY_URL=
# REQUIRED in production: the public media key prefix. Media echoes are PUBLIC records, so
# buildMediaEchoRecord refuses any key outside this prefix — this is what prevents private media
# (DM attachments, vault) from ever being echoed onto the AT network. Leave empty only in dev.
WTFOS_MEDIA_KEY_PREFIX=

# -----------------------------------------------------------------------------
# ADMIN SEED SCRIPT — scripts/seed-admin.ts (not read by the web app)
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
