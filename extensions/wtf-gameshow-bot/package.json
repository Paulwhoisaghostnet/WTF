{
  "name": "wtf-gameshow-bot",
  "version": "0.1.0",
  "private": true,
  "description": "WTF Gameshow Discord bot — mirrors calendar events, forwards voice/stage attendance to the WTF webhook, syncs contestant roles, and exposes the /wtf slash command tree.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/bot.cjs --external:discord.js --external:zod --external:dotenv && esbuild src/scripts/register-commands.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/register-commands.cjs --external:discord.js --external:zod --external:dotenv",
    "start": "cross-env NODE_ENV=production node dist/bot.cjs",
    "start:dev": "tsx src/index.ts",
    "register-commands": "node dist/register-commands.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
