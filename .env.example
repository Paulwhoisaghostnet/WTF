# =============================================================================
# WTF Gameshow — environment template
# Copy to `.env` for local dev. For Netlify: duplicate these keys in the UI
# (Site configuration → Environment variables). Never commit real `.env`.
# =============================================================================

# --- Required for database (Drizzle + connect-pg-simple sessions) ---
# Supabase → Project Settings → Database → Connection string → URI
# Use "Transaction" pooler (port 6543) for Netlify serverless.
# Must be postgresql://... NOT https://xxx.supabase.co
DATABASE_URL=

# openssl rand -hex 32   (use a strong value in production)
SESSION_SECRET=

# --- Supabase project (REST / future JS client) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Server-only; never expose to the browser or frontend bundle
SUPABASE_SERVICE_ROLE_KEY=

# --- URLs (production) ---
# Local: http://localhost:3000  |  Netlify: https://your-site.netlify.app
PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 on Netlify so Express trusts X-Forwarded-* (already handled when NODE_ENV=production)
# TRUST_PROXY=1

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Tezos ---
TEZOS_NETWORK=mainnet
TEZOS_RPC_URL=https://mainnet.ecadinfra.com

# --- App runtime ---
PORT=3000
# Local: development  |  Netlify: set to production in the dashboard
NODE_ENV=development

# =============================================================================
# Netlify checklist (set in dashboard, not only in .env)
# =============================================================================
# DATABASE_URL          = same Transaction pooler URI as local
# SESSION_SECRET        = strong secret (not the dev default)
# NODE_ENV              = production
# PUBLIC_SITE_URL       = https://<your-site>.netlify.app
# SUPABASE_*            = optional unless you add Supabase client code
# GOOGLE_*              = if using Google login; add redirect URI in Google Cloud:
#                         https://<site>/.netlify/functions/api/api/auth/google/callback
#                         (verify path matches your Netlify redirects)
