[Unit]
Description=wtfOS Application Host lightweight window manager
Requires=wtfos-apphost-xvfb.service
After=wtfos-apphost-xvfb.service

[Service]
Type=simple
User=wtfos-apphost
Group=wtfos-apphost
Environment=HOME=/opt/wtfos/apphost/home
Environment=DISPLAY=:99
ExecStart=/usr/bin/openbox
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/wtfos/apphost

[Install]
WantedBy=multi-user.target
