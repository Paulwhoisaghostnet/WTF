# Dedicated systemd EnvironmentFile, owned root:root and mode 0600.
# Copy selected credentials securely on the host. Do not source the app env,
# Cloudflare/R2/DNS env, or operator keyring env into this service.
TEZOS_NETWORK=mainnet
TEZOS_RPC=https://tezos-mainnet.octez.io/
TZKT_API=https://api.tzkt.io
ALEA_ROUTER_ADDRESS=KT1HTY5RFTUai5K2Bh2LVySQvSid9Mx2dP4J
ALEA_REGISTRY_ADDRESS=KT1E7wraYc1cgywqDQX2KGMNF4TbCADsHVL9
ALEA_PROVIDER_ADDRESS=
ALEA_AGENT_ADDRESS=
WTF_ALEATORY_OPERATOR_ADDRESS=
# Owner-selected launch fee, 2026-10-02: 0.5 XTZ. Mutable through set_render_gas.
ALEA_RENDER_GAS_MUTEZ=500000
CF_ACCOUNT_ID=
CF_API_TOKEN=
PINATA_JWT=
WTF_ALEATORY_AGENT_KEYRING=/var/lib/wtf-aleatory-provider/secrets/agent-keyring.json
WTF_ALEATORY_AGENT_MASTER_KEY_FILE=/var/lib/wtf-aleatory-provider/secrets/agent-master.key
WTF_ALEATORY_AGENT_WALLET_ID=aleatory-render-agent
ALEA_STATE_DIR=/var/lib/wtf-aleatory-provider/state
