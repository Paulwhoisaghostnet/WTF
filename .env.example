# =============================================================================
# WTF Gameshow — copy to `.env` and fill in. Do not commit `.env`.
# =============================================================================
# Same keys as production `.env`; use empty values or `changeme` for secrets.

# -----------------------------------------------------------------------------
# POSTGRES — required for docker-compose
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://wtf:changeme@localhost:5432/wtf
# DATABASE_POOL_MAX=15

# -----------------------------------------------------------------------------
# SUPABASE — backup target only (optional) + helper script vars
# -----------------------------------------------------------------------------
# SUPABASE_BACKUP_URL=postgresql://postgres.[ref]:PASSWORD@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_PROJECT_REF=
# SUPABASE_URL=
# VITE_SUPABASE_URL=
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_REGION=

# -----------------------------------------------------------------------------
# SESSION / AUTH
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# OAUTH — client IDs (browser uses VITE_GOOGLE_CLIENT_ID for the login button)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CLIENT_ID=
DISCORD_CLIENT_ID=

GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=
TWITTER_CONSUMER_SECRET=
TWITTER_TOKEN_ENCRYPTION_KEY=
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
DISCORD_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SITE / CORS / PROXY
# -----------------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=

# -----------------------------------------------------------------------------
# TEZOS — network + on-chain addresses
# -----------------------------------------------------------------------------
TEZOS_NETWORK=mainnet
TEZOS_RPC_URL=https://mainnet.ecadinfra.com
VITE_MARKETPLACE_CONTRACT_ADDRESS=
MARKETPLACE_CONTRACT_ADDRESS=
VITE_BARTER_CONTRACT_ADDRESS=
BARTER_CONTRACT_ADDRESS=

# -----------------------------------------------------------------------------
# PROCESS
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# TV — cache, IPFS proxy, media fetch
# -----------------------------------------------------------------------------
TV_CACHE_DIR=
TV_CACHE_MAX_AGE_DAYS=7
TV_CACHE_MAX_REMOTE_BYTES=
TV_CACHE_ALLOWED_HOSTS=
TV_MEDIA_FETCH_TIMEOUT_MS=15000
TV_IPFS_GATEWAYS=

# -----------------------------------------------------------------------------
# W FEED / X API / link preview tuning
# -----------------------------------------------------------------------------
X_API_BASE_URL=
W_FEED_CACHE_MS=60000
W_FEED_MAX_ACCOUNTS=100
W_POSTS_PER_ACCOUNT=10
W_TIMELINE_DAYS_BACK=7
W_X_USER_ID_CACHE_MS=21600000
W_LINK_PREVIEW_CACHE_MS=21600000
W_LINK_PREVIEW_TIMEOUT_MS=3500
W_LINK_PREVIEW_MAX_BYTES=358400
W_LINK_PREVIEW_MAX=30

# -----------------------------------------------------------------------------
# MEDIA / OPS (optional)
# -----------------------------------------------------------------------------
# UPLOADS_DIR=
# COMMIT_REF=

# -----------------------------------------------------------------------------
# ADMIN SEED SCRIPT — scripts/seed-admin.ts (not read by the web app)
# -----------------------------------------------------------------------------
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# CADDY — automatic HTTPS
# -----------------------------------------------------------------------------
SITE_DOMAIN=localhost
