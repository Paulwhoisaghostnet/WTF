# =============================================================================
# WTF Gameshow — copy to `.env` and fill in. Do not commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Project Settings → API  (https://supabase.com/dashboard/project/_/settings/api)
# -----------------------------------------------------------------------------
# These are NOT database connection strings. They are for Supabase REST/Auth/JS.
#
#   • Project URL     → SUPABASE_URL / VITE_SUPABASE_URL
#   • Publishable key → SUPABASE_ANON_KEY / VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY
#   • Secret key      → SUPABASE_SERVICE_ROLE_KEY  (never expose to browser or VITE_*)
#
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# -----------------------------------------------------------------------------
# POSTGRES — not on the API keys page; use Connect or build locally (below)
# -----------------------------------------------------------------------------
# Supabase does not label anything “DATABASE_URL”. You need a Postgres URI starting with postgresql://
#
#   1. In the project: click Connect (top bar), OR open:
#      https://supabase.com/dashboard/project/YOUR_PROJECT_REF?showConnect=true
#   2. Choose Direct / Session pooler / Transaction pooler and copy the string.
#   3. Replace [YOUR-PASSWORD] with your database password.
#      Password / reset: left sidebar Database → Settings (…/database/settings), not the API screen.
#
# The string MUST start with:  postgresql://  or  postgres://
# It is NOT:  https://xxxx.supabase.co  (that is only SUPABASE_URL above)
#
# Example shape (your dashboard shows the exact host/user):
# postgresql://postgres.[ref]:YOUR_DB_PASSWORD@aws-0-[region].pooler.supabase.com:6543/postgres
#
# If the UI won’t show the URI: `npm run db:print-url` builds it from SUPABASE_URL + password.
# Neither the Management API nor `supabase` CLI can return your DB password — set it here or reset in dashboard.
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=   # optional — https://supabase.com/dashboard/account/tokens (pooler needs region from API)
# SUPABASE_REGION=         # optional — e.g. us-east-1 if you skip the token and know your region
# SUPABASE_PROJECT_REF=    # optional — parsed from SUPABASE_URL if omitted
#
DATABASE_URL=

# Optional: max connections in node-pg pool (default 10 for Supabase hosts). Lower on serverless if needed.
# DATABASE_POOL_MAX=3

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
SESSION_SECRET=
# Production: https://your-real-domain (Netlify Site URL). Local dev: http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: server-side GitHub personal access token for API calls (raises rate limit to 5 000/hour)
GITHUB_TOKEN=

# Twitter OAuth 1.0a — https://developer.twitter.com/en/apps → Keys and tokens
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# Discord OAuth2 — https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

TEZOS_NETWORK=mainnet
TEZOS_RPC_URL=https://mainnet.ecadinfra.com
VITE_MARKETPLACE_CONTRACT_ADDRESS=KT1Jt6gU4fS5UYHdhsYyr2EfpBJtXZLrPPfj
MARKETPLACE_CONTRACT_ADDRESS=KT1Jt6gU4fS5UYHdhsYyr2EfpBJtXZLrPPfj
VITE_BARTER_CONTRACT_ADDRESS=KT1WupvcfcSsfp78JPCc6NwKdkdineGfGNdm
BARTER_CONTRACT_ADDRESS=KT1WupvcfcSsfp78JPCc6NwKdkdineGfGNdm

# PORT: only when running `npm start` / Node directly. Netlify Functions ignore PORT.
PORT=3000
# Production: production. Local dev: development (or override via shell when running npm run dev)
NODE_ENV=production

# Netlify (Site → Environment variables): set NODE_ENV=production, PUBLIC_SITE_URL=https://<your-site>,
# SESSION_SECRET, DATABASE_URL, and all VITE_* / SUPABASE_* to match your deployment.
