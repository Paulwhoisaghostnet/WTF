# User-site hosts use on-demand TLS guarded by the app's registration endpoint.
# Only claimed, non-suspended `<username>.wtfos.me` hosts can trigger cert issue.
{
	on_demand_tls {
		ask http://app:3000/internal/tls/allow
	}
}

# wtfOS AT Protocol vhosts (S1.4) are staged in ./Caddyfile.wtfos-atproto and are
# NOT active as a full import because this production Caddyfile owns the current
# wtfos.app blocks below. The `*.wtfos.me` user-site wildcard is active here.
# import Caddyfile.wtfos-atproto

(wtfos_pds_site) {
	encode gzip zstd

	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @ws {args[0]}:3000

	reverse_proxy {args[0]}:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}
}

wtfos.me {
	encode gzip zstd
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}
}

