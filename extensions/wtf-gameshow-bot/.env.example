# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications/<app-id>/bot
DISCORD_BOT_TOKEN=
# Application id (used for slash-command registration)
DISCORD_CLIENT_ID=1490607963260456991
# Primary WTF Discord guild id (used for guild-scoped slash commands + scheduled
# event mirroring). Leave blank only while iterating in DMs.
DISCORD_GUILD_ID=1375286181079810058
# Role id for the "WTF Contestant" role (optional; enables role sync)
DISCORD_CONTESTANT_ROLE_ID=
# Role id for the "WTF Cohost+" role (optional; enables role sync)
DISCORD_STAFF_ROLE_ID=
# Comma-separated role ids the bot must never add/remove.
DICKSWORD_PROTECTED_ROLE_IDS=
# Keep true until you explicitly approve live role reconciliation.
DICKSWORD_ROLE_SYNC_DRY_RUN=true

# ── WTF webhook (bot → WTF server) ───────────────────────────────────────────
# Base URL of the WTF server (e.g. https://wtfgameshow.app)
WTF_WEBHOOK_BASE_URL=
# Shared secret; must match WTF_BOT_WEBHOOK_SECRET on the WTF server .env
WTF_BOT_WEBHOOK_SECRET=

# ── Bot behaviour ────────────────────────────────────────────────────────────
# Polling interval (ms) for calendar mirror + role sync
WTF_MIRROR_INTERVAL_MS=60000
# Heartbeat interval (ms) for users currently in a watched voice/stage channel
WTF_VOICE_HEARTBEAT_MS=60000
# Community XP and activity tuning
DISCORD_XP_MESSAGE_POINTS=1
DISCORD_XP_REACTION_POINTS=2
DISCORD_XP_LEVEL_BASE=100
DISCORD_XP_LEVEL_MULTIPLIER=1.5
DISCORD_IMAGE_CHALLENGE_BASE_POINTS=10
DISCORD_IMAGE_CHALLENGE_BONUS_POINTS=50
DISCORD_TRAIT_SUGGESTION_POINTS=5
DISCORD_TRAIT_ADOPTED_POINTS=100
# DJ remains disabled unless voice/music dependencies are explicitly approved.
DISCORD_DJ_ENABLED=false
# Log level: debug|info|warn|error
LOG_LEVEL=info
