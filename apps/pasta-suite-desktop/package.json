{
  "name": "@wtf/pasta-suite-desktop",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://wtfos.app/tools/ch-ease",
  "desktopName": "pasta-suite",
  "author": {
    "name": "wtfOS",
    "email": "support@wtfos.app"
  },
  "description": "Native Pasta Protocol suite installer builds for Mac, Windows, and Raspberry Pi.",
  "main": "src/main.cjs",
  "scripts": {
    "prepare": "node scripts/prepare-assets.mjs",
    "start": "npm run prepare && electron .",
    "pack": "npm run prepare && electron-builder --dir --publish never",
    "dist": "npm run prepare && electron-builder --publish never",
    "dist:mac": "npm run prepare && electron-builder --mac dmg zip --universal --publish never",
    "dist:mac:dir": "npm run prepare && electron-builder --mac dir --universal --publish never",
    "dist:windows": "npm run prepare && electron-builder --win nsis --x64 --publish never",
    "dist:raspberry-pi": "npm run prepare && electron-builder --linux deb --arm64 --publish never"
  },
  "build": {
    "appId": "app.wtfos.pasta-suite",
    "productName": "Pasta Suite",
    "asar": true,
    "files": [
      "package.json",
      "src/**/*",
      "pasta/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "Pasta-Suite-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "sign": false,
      "license": "build/license_mac.txt",
      "title": "Pasta Suite ${version}",
      "icon": "build/icon.png",
      "iconSize": 128,
      "contents": [
        {
          "x": 180,
          "y": 220,
          "type": "file"
        },
        {
          "x": 480,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "legalTrademarks": "Pasta Suite and wtfOS",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "license": "build/license_en.rtf",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pasta Suite",
      "uninstallDisplayName": "Pasta Suite",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "wtfOS <support@wtfos.app>",
      "syncDesktopName": true,
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "deb": {
      "packageName": "pasta-suite",
      "packageCategory": "devel",
      "maintainer": "wtfOS <support@wtfos.app>"
    }
  },
  "devDependencies": {
    "electron": "42.4.0",
    "electron-builder": "26.15.3"
  }
}
