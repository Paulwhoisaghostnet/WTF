# =============================================================================
# WTF Gameshow — copy to `.env` and fill in. Do not commit `.env`.
# =============================================================================
# Same keys as production `.env`; use empty values or `changeme` for secrets.

# -----------------------------------------------------------------------------
# POSTGRES — Docker Compose + local Drizzle
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme
# For local setup, run `npm run db:setup:local` after copying this file to `.env`.
DATABASE_URL=postgresql://wtf:changeme@localhost:5432/wtf
# Optional admin URL for `npm run db:setup:local` when the default local
# `postgres` database connection is not enough.
LOCAL_POSTGRES_ADMIN_URL=
# Optional: set to 1 if the local role already exists and should be reset to
# the password in DATABASE_URL.
LOCAL_POSTGRES_RESET_ROLE_PASSWORD=
# DATABASE_POOL_MAX=15
POSTGRES_DATA_DIR=/mnt/wtf-data/postgres

# -----------------------------------------------------------------------------
# SUPABASE — HTTP project URL & publishable keys (client / Vite)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=

# -----------------------------------------------------------------------------
# SUPABASE — service role, DB password, backup target
#
# The server runs a nightly off-site backup via `server/lib/supabase-backup.ts`:
# pg_dump → upload to Supabase Storage bucket `SUPABASE_BACKUP_BUCKET`
# (default: wtf-backups).  The job registers with the cockpit scheduler,
# and every run is audited in `sync_runs` as jobName=supabase-backup.
# Admins can trigger an immediate run via POST /api/cockpit/backup/run.
# If either SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY is blank the job
# records a `skipped` sync_runs row and returns — dev environments without
# Supabase creds keep working.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_BACKUP_URL=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_BACKUP_BUCKET=wtf-backups
# BACKUP_LOCAL_KEEP_DAYS=7
# BACKUP_REMOTE_KEEP_DAYS=30

# -----------------------------------------------------------------------------
# HETZNER STORAGE — Object Storage originals + Volume hot cache
#
# Production secrets live in /etc/wtf/wtf.env, not in this repo. Use rotated
# credentials after migration. Hetzner Object Storage endpoint format is
# region.your-objectstorage.com; current bucket plan:
#   S3_ENDPOINT=https://nbg1.your-objectstorage.com
#   S3_REGION=nbg1
#   S3_BUCKET=wtftv
#
# 969 GiB internal limit is intentionally below the 1 TB flat-rate boundary.
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=nbg1
S3_BUCKET=wtftv
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
OBJECT_STORAGE_LIMIT_BYTES=1040450734080
OBJECT_STORAGE_WARN_80_BYTES=832360587264
OBJECT_STORAGE_WARN_90_BYTES=936405660672
OBJECT_STORAGE_PROTECT_95_BYTES=988428527616
MEDIA_UPLOAD_MAX_BYTES=26214400
MEDIA_HOT_CACHE_MAX_BYTES=32212254720
VOLUME_RESERVED_FREE_BYTES=16106127360

# Host/container path plan. Host paths stay on /mnt/wtf-data; container paths
# are stable so code never writes media/caches to the native SSD.
WTF_ENV_FILE=/etc/wtf/wtf.env
WTF_DATA_ROOT=/mnt/wtf-data
UPLOAD_STAGING_DIR=/app/uploads-staging
MEDIA_HOT_CACHE_DIR=/app/cache/users
GM_NFT_CACHE_DIR=/app/cache/gm-nfts
TMP_PROCESSING_DIR=/app/tmp-processing
BACKUPS_STAGING_DIR=/app/backups
LEGACY_UPLOADS_DIR=/app/uploads/media
TV_CACHE_DIR=/app/cache/tv
BUMPER_UPLOADS_DIR=/app/cache/bumpers
UPLOAD_STAGING_DIR_HOST=/mnt/wtf-data/uploads-staging
TV_CACHE_DIR_HOST=/mnt/wtf-data/tv-cache
TMP_PROCESSING_DIR_HOST=/mnt/wtf-data/tmp-processing
BACKUPS_STAGING_DIR_HOST=/mnt/wtf-data/backups-staging
APP_LOG_DIR_HOST=/var/log/wtf/app

# Storage Box / Google Drive backup integration. Do not store passwords here.
WTF_APP_DIR=/opt/wtf-combo
STORAGEBOX_TARGET=u587985@u587985.your-storagebox.de
STORAGEBOX_PORT=23
STORAGEBOX_KEY=/etc/wtf/secrets/storagebox_ed25519
STORAGEBOX_REMOTE_BASE=wtf-server-backups
RCLONE_CONFIG=/etc/wtf/secrets/rclone.conf
GDRIVE_REMOTE=gdrive-wtf:wtf-server-backups
DB_BACKUP_KEEP_DAYS=7
MANIFEST_BACKUP_KEEP_DAYS=30
TMP_CLEAN_MIN_AGE_MS=21600000

# -----------------------------------------------------------------------------
# SESSION — cookies & Passport
# -----------------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------------
# GOOGLE OAUTH — used for (a) user sign-in and (b) Studio Drive storage.
#
# Studio storage runs a Shape-C hybrid — every Studio project is backed
# by one of:
#
#   1. The creating user's own Google Drive (preferred; they connect it
#      from Studio → Your Drive).  Token stored in
#      `studio_storage_accounts`.
#   2. The platform Drive fallback — a single Google account (e.g.
#      wtfgameshowemail@gmail.com) that every project falls back to when
#      the creator hasn't linked a personal Drive.  Token stored in
#      `studio_platform_storage`; admin connects it from Admin → Studio.
#   3. Local disk (dev / last resort).
#
# Both OAuth flows share the same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# but use distinct redirect URIs so the admin and user callbacks can be
# cleanly separated.  Register BOTH URIs in Google Cloud Console:
#
#   GOOGLE_OAUTH_REDIRECT_URI       — admin flow (platform Drive setup),
#     e.g. https://wtf.example.com/api/studio/admin/drive/callback
#   GOOGLE_OAUTH_USER_REDIRECT_URI  — per-user flow (individual Drive
#     connection), e.g.
#     https://wtf.example.com/api/studio/drive/callback
#
# If GOOGLE_OAUTH_USER_REDIRECT_URI is blank, the user flow falls back
# to GOOGLE_OAUTH_REDIRECT_URI — acceptable in dev where only one URL is
# registered, but in production both URIs should be set and registered.
#
#   GOOGLE_DRIVE_ROOT_FOLDER_ID — optional Drive folder id under which
#     the PLATFORM account creates one sub-folder per project.  Leave
#     blank to use "My Drive" root.  User-linked Drives always use the
#     user's "My Drive" directly (no shared folder).
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/studio/admin/drive/callback
GOOGLE_OAUTH_USER_REDIRECT_URI=http://localhost:3000/api/studio/drive/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# -----------------------------------------------------------------------------
# STUDIO — encryption key for sealed platform credentials
#
# Studio refresh tokens and any other per-project OAuth secrets are
# encrypted with AES-256-GCM using a key derived from STUDIO_CRYPTO_KEY
# (SHA-256).  Local dev can fall back to SESSION_SECRET, but production
# requires a dedicated value so session rotation cannot break Drive access.
#
#   STUDIO_LOCAL_PROJECT_QUOTA_BYTES — override the 500 MB default for
#     local_disk-backed projects.
#   STUDIO_DRIVE_PROJECT_QUOTA_BYTES — override the 5 GB default for
#     google_drive-backed projects.  At 5 GB / project a 2 TB platform
#     pool fits ~400 projects; tune up only if you understand the cap.
#   STUDIO_LOCAL_FILE_MAX_BYTES / STUDIO_DRIVE_FILE_MAX_BYTES — hard
#     per-file upload caps; defaults 50 MB and 1 GB respectively.
#   STUDIO_STORAGE_ROOT — path on disk for local_disk driver (defaults
#     to <cwd>/uploads/studio).
# -----------------------------------------------------------------------------
STUDIO_CRYPTO_KEY=
# STUDIO_LOCAL_PROJECT_QUOTA_BYTES=
# STUDIO_DRIVE_PROJECT_QUOTA_BYTES=
# STUDIO_LOCAL_FILE_MAX_BYTES=
# STUDIO_DRIVE_FILE_MAX_BYTES=
# STUDIO_STORAGE_ROOT=

# -----------------------------------------------------------------------------
# GITHUB OAUTH + server API token
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# TWITTER / X — OAuth 1.0a + OAuth2 app id + X API v2 bearer
# -----------------------------------------------------------------------------
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
# Deprecated OAuth 1.0a flow. Disabled and dependency-omitted by default
# because the old strategy pulls a critical xmldom advisory. OAuth 2 is
# the preferred X integration path.
ENABLE_LEGACY_TWITTER_OAUTH=0
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_OAUTH2_REDIRECT_URI=http://localhost:3000/api/auth/twitter-oauth2/callback
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# DISCORD OAUTH2
# -----------------------------------------------------------------------------
DISCORD_CLIENT_ID=1490607963260456991
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=1375286181079810058
# Shared HMAC secret for the WTF Discord bot. Must match the bot `.env`.
WTF_BOT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
