[Unit]
Description=WTF Object Storage usage check
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/wtf/wtf.env
WorkingDirectory=/opt/wtf-combo
ExecStart=/usr/bin/docker compose --env-file /etc/wtf/wtf.env exec -T app npx tsx scripts/object-storage-usage-check.ts

