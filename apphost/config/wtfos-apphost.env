# Non-secret wtfOS client contract for the remote application host.
# Steam credentials are not stored here. Steam auth/session state stays private
# under /opt/wtfos/apphost/home and users never receive Steam control.
WTFOS_APPHOST_SOCKET_PATH=/run/wtf/apphost/apphost.sock
WTFOS_APPHOST_TIMEOUT_MS=15000
WTFOS_APPHOST_ALLOWED_ACTIONS=list,get,status,launch,stop
