        { "name": "Run",       "baseChips": 36, "baseMult": 3, "chipsPerLevel": 10, "multPerLevel": 1.5 },
        { "name": "Pure Run",  "baseChips": 43, "baseMult": 4, "chipsPerLevel": 10, "multPerLevel": 1.5 }
