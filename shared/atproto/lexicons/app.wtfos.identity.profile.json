{
  "lexicon": 1,
  "id": "app.wtfos.identity.profile",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "Public wtfOS identity profile for a DID. Public-by-default fields only; private profile data stays in Postgres.",
      "record": {
        "type": "object",
        "required": ["$type", "schemaVersion", "did", "createdAt"],
        "properties": {
          "$type": { "type": "string", "const": "app.wtfos.identity.profile" },
          "schemaVersion": { "type": "integer" },
          "did": { "type": "string" },
          "handle": { "type": "string", "description": "Resolved handle, e.g. alice.wtfos.me." },
          "displayName": { "type": "string", "maxLength": 640 },
          "description": { "type": "string", "maxLength": 2560 },
          "avatarMediaRef": { "type": "string", "description": "AT URI of an app.wtfos.media.echo record." },
          "wtfUserRef": { "type": "string", "description": "Opaque stable reference to the canonical WTF user." },
          "createdAt": { "type": "string", "format": "datetime" },
          "updatedAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
