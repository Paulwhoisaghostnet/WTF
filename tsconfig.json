{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@wtfos/atproto-spine": ["./packages/atproto-spine/src/index.ts"],
      "@wtfos/atproto-spine/*": ["./packages/atproto-spine/src/*"],
      "@wtfos/sdk": ["./packages/wtfos-sdk/src/index.ts"],
      "@wtfos/sdk/*": ["./packages/wtfos-sdk/src/*"],
      "@wtfos/mcp": ["./packages/wtfos-mcp/src/index.ts"],
      "@wtfos/mcp/*": ["./packages/wtfos-mcp/src/*"]
    },
    "types": ["node"]
  },
  "include": ["client/src/**/*", "server/**/*", "shared/**/*", "netlify/**/*"],
  "exclude": ["node_modules", "dist"]
}
