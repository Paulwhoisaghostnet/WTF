# wtfOS AT Protocol vhosts (S1.4) are staged in ./Caddyfile.wtfos-atproto and are
# NOT active. To activate after DNS (docs/atproto/02-dns-tls.md) points here and
# the `wtfos-atproto` compose profile is up, uncomment the import below. The
# `*.wtfos.me` wildcard + on-demand-TLS global block stays disabled until S2.3
# (see the bottom of Caddyfile.wtfos-atproto for exact instructions).
# import Caddyfile.wtfos-atproto

www.wtfos.app, wtfgameshow.app, www.wtfgameshow.app, new.wtfgameshow.app {
	redir https://wtfos.app{uri} permanent
}

wtfos.app, dues.wtfgameshow.app {
	encode gzip zstd

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @websocket app:3000
}

pds.wtfgameshow.app {
	encode gzip zstd

	reverse_proxy wtfos-pds:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up Host {host}
	}
}

# Shadownet Kiln — native systemd service on the Hetzner host (not in Docker).
# Reached from inside the Caddy container via `host.docker.internal`, which
# resolves to the host gateway IP thanks to the `extra_hosts` entry in
# docker-compose.yml. Kiln listens on :3001; TLS terminates here.
# `scripts/server-deploy.sh` probes a protected mutation through this public
# hostname and fails deployment unless unauthenticated requests return 401/403.
# Keep app `KILN_API_TOKEN` in parity with host Kiln `API_AUTH_TOKEN`.
kiln.wtfgameshow.app {
	encode gzip zstd

	reverse_proxy host.docker.internal:3001 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
