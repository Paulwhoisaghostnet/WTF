# Copy to .env and replace every REPLACE value. Never put .env or secrets in a static-site export.
MACARONI_COMPANION_DATA_DIR=./data
MACARONI_COMPANION_HOST=127.0.0.1
MACARONI_COMPANION_PORT=47835
MACARONI_COMPANION_NETWORK=shadownet
# Secure preference: a creator-controlled/local Octez RPC. A third-party RPC
# receives the plaintext settlement parameters before chain inclusion.
MACARONI_COMPANION_RPC_URL=http://127.0.0.1:8732
MACARONI_COMPANION_RPC_TRUST_MODE=creator_controlled
# Advanced alternative when accepting a third-party RPC trust expansion:
# MACARONI_COMPANION_RPC_URL=https://tezos-shadownet.octez.io/
# MACARONI_COMPANION_RPC_TRUST_MODE=third_party_acknowledged
# MACARONI_COMPANION_ACKNOWLEDGE_RPC_RECEIVES_PRIVATE_SETTLEMENT=I_UNDERSTAND_MY_RPC_PROVIDER_RECEIVES_PRIVATE_SETTLEMENT_DATA
# Every Tezos RPC path still puts settlement CID/entropy in the public mempool.
# pin_on_claim keeps the CAR bytes unavailable until finalized settlement, but
# the pointer can be observed and copied. Read README.md before acknowledging.
MACARONI_COMPANION_ACKNOWLEDGE_MEMPOOL_DISCLOSURE=REPLACE_AFTER_READING_README
# Required value after reading: I_UNDERSTAND_SETTLEMENT_CID_AND_ENTROPY_ENTER_THE_TEZOS_MEMPOOL
MACARONI_COMPANION_INDEXER_URL=https://api.shadownet.tzkt.io/v1
MACARONI_COMPANION_PUBLIC_BASE_URL=https://companion.REPLACE.example
MACARONI_COMPANION_COLLECTOR_ORIGIN=https://drop.REPLACE.example
MACARONI_COMPANION_ALLOWED_ORIGINS=https://drop.REPLACE.example,http://127.0.0.1:5173
# Explicit local-development exception only. Never use this for a remotely hosted page:
# MACARONI_COMPANION_ALLOW_LOOPBACK_COLLECTOR=I_AM_TESTING_A_LOOPBACK_ONLY_DROP

MACARONI_COMPANION_MASTER_KEY_FILE=./secrets/master.key
MACARONI_COMPANION_SIGNER_KEY_FILE=./secrets/finalizer.key
MACARONI_COMPANION_ADMIN_TOKEN_FILE=./secrets/admin.token

# Secure default: download public Objkt index pages and compare CIDs inside this process.
# The target private CIDs are never sent in the GraphQL request.
MACARONI_COMPANION_DUPLICATE_CHECK_MODE=private_full_scan
MACARONI_COMPANION_DUPLICATE_CHECK_URL=https://data.shadownet.objkt.com/v3/graphql
# Advanced/degraded direct lookup only:
# MACARONI_COMPANION_DUPLICATE_CHECK_MODE=external_direct_lookup
# MACARONI_COMPANION_ACKNOWLEDGE_DUPLICATE_INDEX_RECEIVES_PRIVATE_CIDS=I_UNDERSTAND_OBJKT_RECEIVES_EVERY_PRIVATE_CID

MACARONI_COMPANION_PINNING_ADAPTER=kubo
MACARONI_COMPANION_KUBO_API=http://127.0.0.1:5001
MACARONI_COMPANION_IPFS_GATEWAY_URL=https://ipfs.fileship.xyz
# Or use a CAR-capable hosted provider. Its response must return {"cid":"<expected root>"}.
# MACARONI_COMPANION_PINNING_ADAPTER=external-car
# MACARONI_COMPANION_CAR_UPLOAD_URL=https://REPLACE.example/upload-car
# MACARONI_COMPANION_CAR_UPLOAD_TOKEN=REPLACE

MACARONI_V35_CONTRACT_ABI_PATH=./contract/macaroni-v35.contract.json
MACARONI_V35_STORAGE_PATH=./contract/macaroni-v35.storage.tz
MACARONI_V35_TEMPLATE_PATH=./contract/macaroni-v35.template.json
MACARONI_V35_CONTRACT_ABI_SHA256=REPLACE_BY_INSTALLER
MACARONI_V35_STORAGE_SHA256=REPLACE_STORAGE_BY_INSTALLER
MACARONI_V35_TEMPLATE_SHA256=REPLACE_TEMPLATE_BY_INSTALLER
