BARTER_CONTRACT_ADDRESS=
VITE_IN_APP_MARKET_CONTRACT_ADDRESS=KT1JYEAg9FSC6mY9KHNR7Z7kpHpwsDnjKkKE
IN_APP_MARKET_CONTRACT_ADDRESS=KT1JYEAg9FSC6mY9KHNR7Z7kpHpwsDnjKkKE
IN_APP_MARKET_TREASURY_ADDRESS=tz1cVRngZw42KZ42VQF2ZCy2CJSPNG3H7Cgt
CASINO_MEMBERSHIP_CONTRACT_ADDRESS=
CASINO_MEMBERSHIP_TREASURY_ADDRESS=tz1cVRngZw42KZ42VQF2ZCy2CJSPNG3H7Cgt

# -----------------------------------------------------------------------------
# PLATFORM WALLETS — app-to-signer socket only; keys live in signer env/storage
# -----------------------------------------------------------------------------
WTF_OPERATOR_WALLET_ADDRESS=
WTF_OPERATOR_SIGNER_SOCKET=/run/wtf/operator-signer.sock
WTF_OPERATOR_SIGNER_AUTH_TOKEN=
