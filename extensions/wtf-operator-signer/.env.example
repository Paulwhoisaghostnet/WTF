# WTF Operator Signer — environment.
# Never commit a populated copy. SCP to the Hetzner box with `600` perms.

# Tezos RPC the signer broadcasts to. Mainnet by default on prod.
WTF_OPERATOR_SIGNER_RPC=https://tezos-mainnet.octez.io/

# Path the unix socket listens on. The WTF Node app connects here.
# In Docker production the app bind-mounts /run/wtf from the host. The signer
# chmods the socket and every request is still protected by the auth token.
WTF_OPERATOR_SIGNER_SOCKET=/run/wtf/operator-signer.sock

# Shared secret between WTF app and signer; first line of every request
# must carry this in the `auth` field. Rotates via .env SCP + restart.
WTF_OPERATOR_SIGNER_AUTH_TOKEN=change-me

# Legacy single-wallet secret. Keep during migration, then prefer platform
# keyring wallets created through the signer. Treat as a production secret.
WTF_OPERATOR_SIGNER_SECRET=edsk...

# Default wallet id for old disburse/buyback calls that do not specify one.
WTF_OPERATOR_SIGNER_DEFAULT_WALLET_ID=operator

# Encrypted multi-wallet keyring. The master key is the signer root of trust:
# store it as a host secret/systemd credential, never in the repo.
WTF_PLATFORM_KEYRING_PATH=/var/lib/wtf/platform-wallet-keyring.json
WTF_PLATFORM_KEYRING_MASTER_KEY=
WTF_PLATFORM_KEYRING_MASTER_KEY_FILE=
# Default locked for the long-running signer. Use server-local tooling for
# wallet creation instead of enabling app-facing socket creation.
WTF_PLATFORM_KEYRING_CREATE_ENABLED=0

# Explicit allowlist of counterparty contract addresses the signer will
# call with `intent=fund_buyback` etc. Comma-separated. Signer rejects
# calls to addresses outside this list.
WTF_OPERATOR_SIGNER_CONTRACT_ALLOWLIST=

# FA2 assets the signer may disburse as user rewards. Contract:tokenId.
WTF_OPERATOR_SIGNER_DISBURSE_ASSETS=KT1DUZ2nf4Dd1F2BNm3zeg1TwAnA1iKZXbHD:0

# Max XTZ (in mutez) the signer will send in a single operation. Any
# amount above this is rejected regardless of intent.
WTF_OPERATOR_SIGNER_MAX_XTZ_MUTEZ=100000000

# Max recipients in a single FA2 batch transfer.
WTF_OPERATOR_SIGNER_MAX_RECIPIENTS=200

# Set to 1 to allow intent=custom (raw passthrough). Default is 0.
WTF_OPERATOR_SIGNER_ALLOW_CUSTOM=0

# Set to 1 to allow manager-wallet contract origination requests. Keep this
# off except for controlled Shadownet/mainnet deployment windows.
WTF_OPERATOR_SIGNER_ALLOW_ORIGINATION=0
WTF_OPERATOR_SIGNER_MAX_ORIGINATION_BYTES=750000

# Path for the append-only JSON audit log. One line per signed op.
WTF_OPERATOR_SIGNER_AUDIT_LOG=/var/log/wtf/operator-signer.log
