# colleKT for WTF
#
# Standalone deployment:
# - Set both values to https://wtfgameshow.app in production.
# - The client value lets `/wtf` call WTF's bridge API directly with browser
#   credentials. The server value is the fallback for same-origin/reverse-proxy
#   deployments that call this module's `/api/user?address=wtf:me`.
NEXT_PUBLIC_WTF_API_ORIGIN=http://localhost:3000
WTF_API_ORIGIN=http://localhost:3000

# Optional Redis cache used by upstream colleKT's TzKT/objkt routes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3001
